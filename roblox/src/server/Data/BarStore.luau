--!strict
-- Month-chunk bar loader. Decoded bars are SERVER-ONLY: nothing in here is
-- replicated — the replay session alone decides which bars a client may see.
--
-- Per month, in order: in-memory cache -> DataStore "bars_v1" -> the bundled
-- SampleData module. Studio without API access always lands on the last path,
-- so every platform call is pcall-wrapped instead of asserted; a failed load
-- degrades to the sample, never to an error.

local DataStoreService = game:GetService("DataStoreService")
local EncodingService = game:GetService("EncodingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local BarCodec = require(Shared.Data.BarCodec)
local ContractMath = require(Shared.Trading.ContractMath)
local Et = require(Shared.Time.Et)
local Types = require(Shared.Types)

type Bar = Types.Bar

export type DayMeta = { date: string, firstTs: number, lastTs: number, barCount: number }
export type SampleData = { b64: string, days: { DayMeta } }

local M = {}

local DATASTORE_NAME = "bars_v1"
local MANIFEST_KEY = "manifest"
local MONTH_KEY_PREFIX = "m:"


type Chunk = { bars: { Bar }, tickSize: number }

local chunks: { [string]: Chunk } = {}
local missingChunks: { [string]: boolean } = {} -- negative cache: don't re-hit DataStore
local manifest: { DayMeta }? = nil
local resolvedTick: number? = nil

local store: DataStore? = nil
local storeTried = false

local sampleChunk: Chunk? = nil
local sampleData: SampleData? = nil
local sampleTried = false

local function getStore(): DataStore?
	if not storeTried then
		storeTried = true
		local ok, result = pcall(function()
			return DataStoreService:GetDataStore(DATASTORE_NAME)
		end)
		if ok then
			store = result
		end
	end
	return store
end

-- The dataset is single-instrument, so tickSize is uniform across chunks. It
-- is resolved ONCE and never revised: SessionInfo ships it to clients at join,
-- before any day has loaded, and that value has to stay true afterwards.
local function noteTick(tick: number)
	if resolvedTick == nil then
		resolvedTick = tick
	elseif resolvedTick ~= tick then
		warn(`[BarStore] chunk tickSize {tick} differs from resolved {resolvedTick}; keeping resolved`)
	end
end

local function decodeChunk(b64: string): Chunk?
	local okDecode, raw = pcall(function()
		return EncodingService:Base64Decode(buffer.fromstring(b64))
	end)
	if not okDecode then
		return nil
	end
	local okBars, bars = pcall(BarCodec.decode, raw)
	if not okBars then
		return nil
	end
	-- Every downstream index assumption (revealedCount, encodeSlice ranges)
	-- rests on ascending open times; the preprocessing tool emits them sorted,
	-- this only guarantees it.
	table.sort(bars, function(a: Bar, b: Bar): boolean
		return a.t < b.t
	end)
	local tick = BarCodec.tickSizeOf(raw)
	noteTick(tick)
	return { bars = bars, tickSize = tick }
end

local function loadSample(): SampleData?
	if sampleTried then
		return sampleData
	end
	sampleTried = true
	-- Generated by a separate tool and may legitimately be absent in a dev
	-- checkout, so this is a lookup rather than a static require.
	local module = script.Parent:FindFirstChild("SampleData")
	if module == nil or not module:IsA("ModuleScript") then
		return nil
	end
	local ok, result = pcall(require, module)
	if not ok or typeof(result) ~= "table" then
		warn("[BarStore] SampleData present but failed to load")
		return nil
	end
	sampleData = result :: SampleData
	return sampleData
end

local function loadSampleChunk(): Chunk?
	if sampleChunk ~= nil then
		return sampleChunk
	end
	local data = loadSample()
	if data == nil or typeof(data.b64) ~= "string" then
		return nil
	end
	sampleChunk = decodeChunk(data.b64)
	return sampleChunk
end

local function loadMonth(monthKey: string): Chunk?
	local cached = chunks[monthKey]
	if cached ~= nil then
		return cached
	end
	if not missingChunks[monthKey] then
		local ds = getStore()
		if ds ~= nil then
			local ok, value = pcall(function()
				return ds:GetAsync(MONTH_KEY_PREFIX .. monthKey)
			end)
			if ok and typeof(value) == "string" then
				local chunk = decodeChunk(value)
				if chunk ~= nil then
					chunks[monthKey] = chunk
					return chunk
				end
			end
		end
		missingChunks[monthKey] = true
	end
	return loadSampleChunk()
end

local function coerceDays(value: any): { DayMeta }
	-- The manifest key may hold either the day array directly or a record
	-- wrapping it; both shapes are accepted so the upload tool can pick.
	local raw: any = value
	if typeof(value.days) == "table" then
		raw = value.days
	end
	local out: { DayMeta } = {}
	for _, entry in ipairs(raw :: { any }) do
		if typeof(entry) == "table" and typeof(entry.date) == "string" then
			table.insert(out, {
				date = entry.date,
				firstTs = if typeof(entry.firstTs) == "number" then entry.firstTs else 0,
				lastTs = if typeof(entry.lastTs) == "number" then entry.lastTs else 0,
				barCount = if typeof(entry.barCount) == "number" then entry.barCount else 0,
			})
		end
	end
	return out
end

local function loadManifest(): { DayMeta }
	local cached = manifest
	if cached ~= nil then
		return cached
	end
	local days: { DayMeta } = {}
	local ds = getStore()
	if ds ~= nil then
		local ok, value = pcall(function()
			return ds:GetAsync(MANIFEST_KEY)
		end)
		if ok and typeof(value) == "table" then
			days = coerceDays(value)
		end
	end
	if #days == 0 then
		local data = loadSample()
		if data ~= nil and typeof(data.days) == "table" then
			days = coerceDays({ days = data.days })
		end
	end
	-- ISO dates sort lexicographically; the picker order is observable output,
	-- so it can never come from DataStore/table iteration order.
	table.sort(days, function(a: DayMeta, b: DayMeta): boolean
		return a.date < b.date
	end)
	manifest = days
	return days
end

local function parseDate(date: string): (number?, number?, number?)
	local y, mo, d = string.match(date, "^(%d%d%d%d)-(%d%d)-(%d%d)$")
	if y == nil then
		return nil, nil, nil
	end
	return tonumber(y), tonumber(mo), tonumber(d)
end

function M.availableDates(): { string }
	local out: { string } = {}
	for _, day in ipairs(loadManifest()) do
		table.insert(out, day.date)
	end
	return out
end

function M.hasDate(date: string): boolean
	for _, day in ipairs(loadManifest()) do
		if day.date == date then
			return true
		end
	end
	return false
end

-- The bars of ONE trading day (18:00 ET the previous evening through the
-- 17:00-17:59 ET hour the old-era sessions traded into), in ascending time.
function M.dayBars(date: string): { Bar }?
	local y, mo, d = parseDate(date)
	if y == nil or mo == nil or d == nil then
		return nil
	end
	local chunk = loadMonth(string.sub(date, 1, 7))
	if chunk == nil then
		return nil
	end
	-- A trading DATE's month bucket is the month of that date, so noon ET on it
	-- is always inside the day and anchors the 18:00 ET open.
	local dayStart = Et.tradingDayStartSec(Et.etWallToUtc(y, mo, d, 12))
	local dayEnd = dayStart + 86400
	local out: { Bar } = {}
	for _, b in ipairs(chunk.bars) do
		if b.t >= dayStart and b.t < dayEnd and Et.tradingDateOf(b.t) == date then
			table.insert(out, b)
		end
	end
	if #out == 0 then
		return nil
	end
	return out
end

function M.tickSize(): number
	if resolvedTick == nil then
		-- Nothing decoded yet (SessionInfo at join): pay for the sample decode
		-- rather than ship a guess the first loaded chunk might contradict.
		loadSampleChunk()
	end
	local tick = resolvedTick
	return if tick ~= nil then tick else ContractMath.NQ.tickSize
end

function M.baseSec(): number
	return Types.BASE_RESOLUTION_SEC
end

return M
